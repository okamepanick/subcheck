<div class="container">

<h2 class="my-4">利用ユーザー一覧</h2>

<table class="table table-striped table-bordered">

  <thead>
    <tr>
      <th>表示名</th>
      <th>LINEユーザーID</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @line_users.each do |line_user| %>
      <tr>
        <td><%= line_user.display_name %></td>
        <td><%= line_user.line_uid %></td>
        <td><%= link_to "詳細", subscriptions_path(line_user_id: line_user.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

</div>
