<div class="container w-50">
  <div class="text-center mt-5">
    <h2>新規会員登録</h2>
  </div>

  <div class="row justify-content-center">
    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), local: true do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-3">
        <%= f.label :username, "ユーザー名", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.text_field :username, autofocus: true, class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.email_field :email, autocomplete: "email", class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード", class: "text-secondary fw-bold py-md-3" %>
        <span class="p_required">必須</span>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード確認", class: "text-secondary fw-bold py-md-3" %>
        <span class="p_required">必須</span>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="text-center py-md-3 mt-5">
        <%= f.submit "登録する" %>
      </div>
    <% end %>
  </div>
</div>
