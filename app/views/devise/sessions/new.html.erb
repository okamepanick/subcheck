<div class="container w-50">
  <div class="text-center mt-5">
    <h2>ログイン</h2>
  </div>

<%= form_with model: resource, as: resource_name, url: session_path(resource_name), local: true do |f| %>
  <div class="field">
    <%= f.label :email, "メールアドレス", class: "text-secondary fw-bold mb-2" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control shadow-sm py-md-3" %>
  </div>

  <div class="field mt-3">
    <%= f.label :password, "パスワード", class: "text-secondary fw-bold mb-2" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "form-control shadow-sm py-md-3" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field mt-4">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "ログイン状態を保持する" %>
    </div>
  <% end %>

  <div class="text-center py-md-3 mt-5">
    <%= f.submit "ログイン" %>
  </div>
<% end %>

</div>
