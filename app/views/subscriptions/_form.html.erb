 <div class="row justify-content-center">
    <%= form_with model: subscription, local: false, id: "liff-subscription-form" do |f| %>
      <% if subscription.errors.any? %>
        <div class="alert alert-danger">
          <h3><%= subscription.errors.count %>件のエラーが発生しました</h3>
          <ul>
            <% subscription.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="my-3">
        <%= f.label :service_name, "利用サービス名", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.text_field :service_name, class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="my-3">
        <%= f.label :start_date, "支払い開始日", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.date_field :start_date, class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="my-3">
        <%= f.label :next_billing_date, "次回請求日", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.date_field :next_billing_date, class: "form-control shadow-sm py-md-3" %>
      </div>

      <div class="my-3">
        <%= f.label :billing_cycle, "支払い頻度", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.select :billing_cycle, options_for_select([["月払い", "monthly"], ["年払い", "yearly"]]), {}, class: "form-control shadow-sm py-mb-3" %>
      </div>

      <div class="my-3">
        <%= f.label :price, "利用料金", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.number_field :price, class: "form-control shadow-sm py-md-3"%>
      </div>

      <div class="my-3">
        <%= f.label :payment_method, "支払い方法", class: "text-secondary fw-bold mb-2" %>
        <span class="p_required">必須</span>
        <%= f.select :payment_method, options_for_select([["クレジットカード", "credit_card"], ["銀行振込", "bank_transfer"], ["口座振替", "direct_debit"]]), {}, class: "form-control shadow-sm py-mb-3" %>
      </div>

      <%= f.hidden_field :line_user_id, id: 'line_user_id', value: "" %>

      <div class="text-center py-md-3">
        <%= f.submit button_text, class: "btn btn-primary", id: "submit_btn" %>
      </div>
    <% end %>
  </div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    await liff.init({ liffId: "<%= ENV['SUBSCRIPTION_CREATE_LIFF_ID'] %>" });

    const profile = await liff.getProfile();
    const userId = profile.userId;

    const hiddenField = document.getElementById("line_user_id");
    if (hiddenField) {
      hiddenField.value = userId;
    }

    //フォーム送信の処理
    const form = document.getElementById('liff-subscription-form')
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('submit_btn');
        submitBtn.disabled = true;
        submitBtn.value = '送信中...';

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            }
          });

          const result = await response.json();

          if (response.ok && result.success) {
            //処理が成功したら LIFF の画面を閉じる処理をここで行う
            liff.closeWindow();
          } else {
            //エラーを表示する
            alert(result.error || 'エラーが発生しました');
            submitBtn.disabled = false;
            submitBtn.value = '登録する';
          }
        } catch (error) {
          console.error('Form submission error:', error);
          alert('エラーが発生しました');
          submitBtn.disabled = false;
          submitBtn.value = '登録する';
        }
      });
    }
  });
</script>
