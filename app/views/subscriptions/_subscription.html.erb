<div class="container">

<div class="card my-5">
  <div class="card-body d-flex justify-content-around">
    <div>
      <h2 class="card-title">総額</h2>
      <h5 class="card-title alert alert-primary" role="alert">¥<%= @total_amount %>/月</h5>
    </div>
    <div>
      <h2 class="card-title">次回更新日</h2>
        <% @next_subscriptions.each do |next_subscription| %>
          <h5 class="card-title alert alert-primary" role="alert"><%= next_subscription.service_name %>
          <%= next_subscription.formatted_next_billing_date %>
        </h5>
        <% end %>
    </div>
  </div>
</div>

<h2>サブスク一覧</h2>

<table class="table table-striped table-bordered">

  <thead>
    <tr>
      <th>サービス名</th>
      <th>料金</th>
      <th>開始日</th>
      <th>次回更新日</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @subscriptions.each do |subscription| %>
      <tr>
        <td><%= subscription.service_name %></td>
        <td><%= subscription.billing_cycle_text %> <%= subscription.price %>円</td>
        <td><%= subscription.formatted_start_date %></td>
        <td><%= subscription.formatted_next_billing_date %></td>
        <td><%= link_to '詳細', subscription_path(subscription) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

</div>
