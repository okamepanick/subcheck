<div class="container">

<div class="card my-5">
  <div class="card-body d-flex justify-content-around">
    <div>
      <h5 class="card-title">総額</h5>
      <h5 class="card-title">¥<%= @total_amount%></h5>
    </div>
    <div>
      <h5 class="card-title">次回更新日</h5>
      <h5 class="card-title"><%= @next_subscription.next_billing_date %></h5>
    </div>
  </div>
</div>

<h2>サブスク一覧</h2>

<table class="table table-striped table-bordered">

  <thead>
    <tr>
      <th>サービス名</th>
      <th>料金</th>
      <th>開始日</th>
      <th>次回更新日</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @subscriptions.each do |subscription| %>
      <tr>
        <td><%= subscription.service_name %></td>
        <td>¥ <%= subscription.price %></td>
        <td><%= subscription.start_date.strftime("%Y年%m月%d日") %></td>
        <td><%= subscription.next_billing_date.strftime("%Y年%m月%d日") %></td>
        <td><%= link_to '詳細', subscription_path(subscription) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

</div>
