<div class="container">

<div class="card my-5">
  <div class="card-body d-flex justify-content-around">
    <div>
      <h2 class="card-title">総額</h2>
      <% if @total_amount > 0 %>
        <h5 class="card-title alert alert-primary my-5" role="alert">¥<%= @total_amount %>/月</h5>
      <% else %>
        <div class="alert alert-warning h5" role="alert">
          現在、登録されているサブスクリプションはありませんので、総額は0円です。
          <br>
          <p class="">サブスクを登録しましょう！<p>
          <div class="d-flex justify-content-center">
            <%= link_to 'サブスクリプションを登録しよう！', new_subscription_path, class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
    <div>
      <h2 class="card-title">次回更新日</h2>
      <% if @next_subscriptions.any? %>
        <% @next_subscriptions.each do |next_subscription| %>
          <h5 class="card-title alert alert-primary" role="alert"><%= next_subscription.service_name %>
          <%= next_subscription.next_billing_date.strftime("%Y年%m月%d日") %>
        </h5>
        <% end %>
      <% else %>
        <div class="alert alert-warning h5" role="alert">
          次回更新日が設定されていません
        </div>
      <% end %>
    </div>
  </div>
</div>

<h2>サブスク一覧</h2>

<table class="table table-striped table-bordered">

  <thead>
    <tr>
      <th>サービス名</th>
      <th>料金</th>
      <th>開始日</th>
      <th>次回更新日</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @subscriptions.each do |subscription| %>
      <tr>
        <td><%= subscription.service_name %></td>
        <td>¥ <%= subscription.price %></td>
        <td><%= subscription.start_date.strftime("%Y年%m月%d日") %></td>
        <td><%= subscription.next_billing_date.strftime("%Y年%m月%d日") %></td>
        <td><%= link_to '詳細', subscription_path(subscription) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

</div>
