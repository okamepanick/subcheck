<div class="container w-50">
  <div class="text-center mt-5">
    <h2>サブスク編集</h2>
  </div>

  <%= render partial: 'liff_edit_form', locals: { subscription: @subscription, button_text: '更新する' } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    await liff.init({ liffId: "<%= ENV['SUBSCRIPTION_EDIT_LIFF_ID'] %>" });

    const profile = await liff.getProfile();
    const userId = profile.userId;

    const hiddenField = document.getElementById("line_user_id");
    if (hiddenField) {
      hiddenField.value = userId;
    }
  });
</script>